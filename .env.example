# ── Supabase ────────────────────────────────────────────────────────────────────
# Obtain from your Supabase project: Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Places API (optionnel — désactivé par défaut) ────────────────────────
# L'app utilise OpenStreetMap (Overpass) par défaut : gratuit, sans clé.
# Pour activer Google Places (données plus riches, notes, photos) :
#   1. Créer un projet sur https://console.cloud.google.com
#   2. Activer "Places API (New)" + configurer un plafond de dépense
#   3. Décommenter la ligne ci-dessous et changer l'import dans WaitingRoomScreen.jsx
# VITE_GOOGLE_PLACES_KEY=AIzaSy...

# ── Gemini Flash (optionnel — désactivé par défaut) ──────────────────────────────
# Filtrage IA du budget et des allergies avant la sélection finale des 3 restaurants.
# Gratuit, sans carte bancaire : créer une clé sur https://aistudio.google.com
# Sans clé, ou en cas de quota gratuit dépassé, l'app retombe automatiquement sur la
# sélection algorithmique standard (cuisine + mode) — jamais d'erreur visible.
# VITE_GEMINI_API_KEY=AIzaSy...
